---
// src/pages/cv/criq.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="CV - CriQ" sideBarActiveItemID="cv">
  <div class="flex justify-center mb-8">
    <div class="tabs tabs-boxed bg-base-200 p-1">
      <a href="/cv/criq" class="tab tab-active font-bold">CriQ</a>
      <a href="/cv/h1ra2" class="tab">H1Ra2</a>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">CriQ</div>
    <div class="text-sm opacity-60 mt-1">Leader of CriQTech</div>
  </div>

  <div class="mb-10 leading-relaxed">
    CriQTech의 메인 개발자이자 에디터입니다.
  </div>

  <div class="text-2xl w-full font-bold mb-3">연혁</div>
  <div class="border-l-2 border-primary pl-4 py-1 mb-10">
    <div class="font-bold">CriQTech</div>
    <div class="text-xs opacity-60">2026 - </div>
  </div>
</BaseLayout>