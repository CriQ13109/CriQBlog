---
// src/pages/cv/h1ra2.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="CV - H1Ra2" sideBarActiveItemID="cv">
  <!-- 작성자 전환 탭 -->
  <div class="flex justify-center mb-8">
    <div class="tabs tabs-boxed bg-base-200 p-1">
      <a href="/cv/criq" class="tab">CriQ</a>
      <a href="/cv/h1ra2" class="tab tab-active font-bold">H1Ra2</a>
    </div>
  </div>

  <!-- 프로필 -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">H1Ra2</div>
    <div class="text-sm opacity-60 mt-1">Tech Reviewer & Contributor</div>
  </div>

  <div class="mb-10 leading-relaxed">
    테크 하드웨어 리뷰어 H1Ra2입니다.
  </div>

  <div class="text-2xl w-full font-bold mb-3">Reviews & Activity</div>
  <div class="border-l-2 border-secondary pl-4 py-1 mb-10">
    <div class="font-bold">Hardware Reviewer</div>
    <div class="text-xs opacity-60">2026 - Present</div>
  </div>
</BaseLayout>