---
const { title, img, desc, url, badge, tags, target = "_blank", author, pubDate } = Astro.props;
import { Image } from "astro:assets";
import dayjs from "dayjs";

const displayDate = pubDate ? dayjs(pubDate).format("YYYY.MM.DD") : "";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        
        <p class="py-1 text-1xl">{desc}</p>

        <div class="text-xs text-base-content/60 mt-1 flex items-center gap-1.5 font-normal">
          {pubDate && <time>{displayDate}</time>}
          {pubDate && author && <span>•</span>}
          {author && <span>by {author}</span>}
        </div>

        <div class="card-actions justify-end mt-2">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
